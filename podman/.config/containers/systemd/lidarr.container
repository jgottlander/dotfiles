[Unit]
Description=Lidarr container
Wants=network-online.target
After=network-online.target local-fs.target

[Container]
ContainerName=lidarr
Image=ghcr.io/hotio/lidarr
AutoUpdate=registry
User=0
UserNS=keep-id:uid=1000,gid=1000
GroupAdd=keep-groups

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Stockholm
Environment=UMASK=002

PublishPort=8686:8686

Volume=lidarr_data:/config
Volume=/mnt/media/Musik:/data/music
Volume=/mnt/externa/Nedladdningar:/data/downloads
Volume=/mnt/externa/Papperskorg:/data/recycling

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
