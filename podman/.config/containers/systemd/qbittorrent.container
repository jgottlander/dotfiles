[Unit]
Description=qBittorrent container
Wants=network-online.target
After=network-online.target local-fs.target gluetun.service

[Container]
ContainerName=qbittorrent
Image=docker.io/qbittorrentofficial/qbittorrent-nox:latest
AutoUpdate=registry

User=0
UserNS=keep-id:uid=1000,gid=1000
GroupAdd=keep-groups

Network=gluetun.container

Environment=QBT_LEGAL_NOTICE=config
Environment=QBT_VERSION=latest
Environment=TZ=Europe/Stockholm
Environment=QBT_WEBUI_PORT=8081
Environment=QBT_TORRENTING_PORT=6881
Environment=QBT_CONFIG_PATH="/config"
Environment=QBT_DOWNLOADS_PATH="/data/downloads"

Volume=qbittorrent_data:/config
Volume=/mnt/externa/media/downloads:/data/downloads:rw

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
