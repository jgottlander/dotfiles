[Unit]
Description=GlueTun VPN container
Wants=network-online.target
After=network-online.target local-fs.target

[Container]
ContainerName=gluetun
Image=docker.io/qmcgaw/gluetun:v3
AutoUpdate=registry
AddCapability=NET_ADMIN
AddDevice=/dev/net/tun:/dev/net/tun
PodmanArgs=--privileged
Volume=gluetun_data:/gluetun:Z

# qBittorrent
PublishPort=8081:8081
PublishPort=6881:6881
PublishPort=6881:6881/udp

# slskd
PublishPort=5030:5030
PublishPort=5031:5031

Environment=TZ=Europe/Stockholm
Environment=BLOCK_MALICIOUS=off
Environment=VPN_SERVICE_PROVIDER=protonvpn
Environment=VPN_TYPE=wireguard
Secret=protonvpn_privatekey,type=env,target=WIREGUARD_PRIVATE_KEY
Environment=SERVER_COUNTRIES=Sweden
Environment=VPN_PORT_FORWARDING=on
EnvironmentFile=./gluetun.env

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
