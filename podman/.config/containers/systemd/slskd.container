[Unit]
Description=slskd
After=network-online.target local-fs.target

[Container]
ContainerName=slskd
Image=docker.io/slskd/slskd
AutoUpdate=registry

UserNS=keep-id
GroupAdd=keep-groups

Network=gluetun.container

#Environment=PUID=1000
#Environment=PGID=1000
Environment=TZ=Europe/Stockholm
Environment=WEBUI_PORTS=5030/tcp,5031/tcp
Environment=SLSKD_REMOTE_CONFIGURATION=true

Volume=slskd_config:/app
Volume=/mnt/externa/media:/data

[Service]
Restart=always
TimeoutStartSec=900

[Install]
#WantedBy=default.target
