[Unit]
Description=Immich Postgres Database
Wants=network-online.target
After=network-online.target local-fs.target

[Container]
ContainerName=immich-db
Image=ghcr.io/immich-app/postgres:18-vectorchord0.5.3
Pod=immich.pod
GroupAdd=keep-groups
ShmSize=2G

Environment=POSTGRES_PASSWORD=postgres123
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS='--data-checksums'

Volume=immich-db_data:/var/lib/postgresql

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target immich-server.container
