[Unit]
Description=iSponsorBlockTV
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=isponsorblocktv
Image=ghcr.io/dmunozv04/isponsorblocktv
AutoUpdate=registry
UserNS=keep-id
GroupAdd=keep-groups
Network=host
Volume=isponsorblocktv_data:/app/data

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
