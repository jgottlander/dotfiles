[Unit]
Description=Caddy webserver
After=network.target local-fs.target

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:alpine
AutoUpdate=registry
Pod=nextcloud.pod
AddCapability=CAP_NET_ADMIN
Environment=EMAIL=josef.gottlander@pm.me
GroupAdd=keep-groups

Volume=./Caddyfile:/etc/caddy/Caddyfile:z
Volume=caddy_data:/data:Z
Volume=nextcloud_data:/var/www/html:z
Notify=true

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
