[Unit]
Description=Seerr
After=network.target

[Container]
ContainerName=seerr
Image=ghcr.io/seerr-team/seerr:latest
AutoUpdate=registry
User=0
UserNS=keep-id:uid=1000,gid=1000
GroupAdd=keep-groups
PublishPort=5055:5055
RunInit=true

Environment=TZ=Europe/Stockholm
Environment=PORT=5055/tcp

Volume=seerr_data:/app/config

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
